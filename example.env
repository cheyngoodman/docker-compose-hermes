# ── Permissions ────────────────────────────────────────────────────
# UID/GID for container users. Default 1000 matches most Linux hosts.
HERMES_UID=1000
HERMES_GID=1000

# ── Dashboard (:9119) ──────────────────────────────────────────────
# Dashboard runs inside the agent container (HERMES_DASHBOARD=1).
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=changeme
# Generate:  openssl rand -base64 32
HERMES_DASHBOARD_SECRET=

# ── WebUI (:8787) ──────────────────────────────────────────────────
# Password for the WebUI login page. Required for remote access.
# Disable WebUI entirely: comment out the hermes-webui service block
# in docker-compose.yml. No env var toggle needed.
# Generate:  openssl rand -base64 18
HERMES_WEBUI_PASSWORD=