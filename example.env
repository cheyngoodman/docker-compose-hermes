HERMES_UID=1000
HERMES_GID=1000
HERMES_DASHBOARD_USERNAME=admin
HERMES_DASHBOARD_PASSWORD=changeme
HERMES_DASHBOARD_SECRET=<32+ random bytes; openssl rand -base64 32>

# Hermes WebUI (in-container web interface at :8787)
# Set to 0 to disable; enabled by default.
HERMES_WEBUI_ENABLED=1
# Password for the WebUI login page. REQUIRED — the WebUI binds to 0.0.0.0
# and must have auth enabled. Generate a strong password:
#   openssl rand -base64 18
HERMES_WEBUI_PASSWORD=
